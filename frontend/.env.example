# Server-only. URL del backend FastAPI, senza slash finale.
BACKEND_URL=http://127.0.0.1:8000
# Stesso valore di API_SECRET_KEY sul backend. Vuoto se il backend non lo usa.
API_SECRET_KEY=
# Accesso HTTP Basic obbligatorio in produzione, opzionale in sviluppo.
FRONTEND_USERNAME=
FRONTEND_PASSWORD=
# Build statica Netlify: URL pubblico, nessuna chiave in variabili NEXT_PUBLIC.
NEXT_PUBLIC_BACKEND_URL=https://backend-net-billy-production.up.railway.app
